# These are ENVIRONMENT VARIABLES. The backend does not read this file by itself: set them in your
# shell (see README) or in the hosting dashboard. Never commit real values.
# Required in production: a long random string (python3 -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=
# Development default is SQLite. For hosting use a Postgres connection string.
DATABASE_URL=sqlite:///./twacha.db
# Free token from https://aqicn.org/data-platform/token/
WAQI_TOKEN=
DEFAULT_CITY=bhopal
# Demo only (presentation): 1 enables /demo/seed and /demo/reset
ENABLE_DEMO=0
# Comma-separated origins, or * while testing
CORS_ORIGINS=*
